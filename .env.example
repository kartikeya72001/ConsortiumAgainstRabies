# ===================================================
# Consortium Against Rabies - Environment Variables
# 100% Free Tier Setup for Vercel, Supabase & Cloudinary
# ===================================================

# 1. Supabase (PostgreSQL Database + Auth + 1GB Storage) - FREE
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Cloudinary (Optional Image Compression & CDN) - FREE (25GB/mo)
# Get from: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# 3. Admin Security Passphrase (Works out of the box for /admin dashboard)
ADMIN_SECRET_KEY=car_admin_2026_secure
